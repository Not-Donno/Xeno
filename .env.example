# ============================================================
# XENO MARKETPLACE - ENVIRONMENT VARIABLES
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ---------- Database ----------
POSTGRES_USER=xeno
POSTGRES_PASSWORD=xeno_secret
POSTGRES_DB=xeno
POSTGRES_PORT=5432

# ---------- Backend ----------
NODE_ENV=development
PORT=3001

# Prisma connection string (used by backend container)
DATABASE_URL=postgresql://xeno:xeno_secret@localhost:5432/xeno?schema=public

# ---------- Auth / JWT ----------
# Generate strong random values for production:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- File Storage ----------
# local | s3 (s3 not yet implemented, falls back to local)
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_MB=5

# ---------- Frontend ----------
# Public URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001
# Internal URL the Next.js server uses to reach the backend (Docker network)
API_URL=http://backend:3001
FRONTEND_URL=http://localhost:3000

# ---------- App ----------
APP_NAME=XENO
APP_URL=http://localhost:3000
